{
  "name": "@react-native-ohos/react-native-headless",
  "version": "0.0.5-beta.1",
  "description": "Headless, Foreground and Background for React Native (Android + HarmonyOS)",
  "main": "./dist/commonjs/index.js",
  "module": "./dist/module/index.js",
  "react-native": "./dist/module/index.js",
  "types": "./dist/typescript/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/react-native-oh-library/react-native-headless.git"
  },
  "author": {
    "name": "Anton Dodonov",
    "email": "cpodimas@gmail.com"
  },
  "bugs": {
    "url": "https://github.com/react-native-oh-library/react-native-headless/issues"
  },
  "homepage": "https://github.com/react-native-oh-library/react-native-headless/tree/master#readme",
  "keywords": [
    "react-component",
    "react-native",
    "harmony",
    "headless",
    "headlessjs"
  ],
  "files": [
    "dist/",
    "src/",
    "harmony/",
    "index.js",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "prepare": "bob build",
    "codegen-lib": "react-native codegen-harmony --cpp-output-path ./harmony/headless/src/main/cpp/generated --ets-output-path ./harmony/headless/src/main/ets/generated",
    "start": "react-native start",
    "test": "jest --config ./jest/jest.config.js",
    "test:coverage": "jest --coverage --config ./jest/jest.config.js",
    "lint": "eslint ."
  },
  "nativePackage": "true",
  "peerDependencies": {
    "react-native": ">=0.72"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/preset-typescript": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/eslint-config": "^0.72.2",
    "@react-native-oh/react-native-harmony-cli": "^0.77.50",
    "@react-native/typescript-config": "0.79.5",
    "@types/react": "18.2.79",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "metro": "^0.81.0",
    "metro-react-native-babel-preset": "0.76.8",
    "react": "18.2.0",
    "react-native": "0.72.5",
    "react-native-builder-bob": "^0.18.0",
    "react-test-renderer": "18.2.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  },
  "harmony": {
    "alias": "react-native-headless",
    "autolinking": {
      "cmakeLibraryTargetName": "headless",
      "ohPackageName": "@react-native-ohos/react-native-headless",
      "etsPackageClassName": "HeadlessPackage",
      "cppPackageClassName": "HeadlessPackage"
    },
    "codegenConfig": [
      {
        "version": 1,
        "specPaths": [
          "./src/specs"
        ]
      }
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  }
}
